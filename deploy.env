# sv-deploy config: ships origin/main to the cluster sv-oke (code.small-victories.co).
# See ../Oracle/deploy/README.md. Run: npm run deploy (or npm run deploy:check).
APP=rustpad
# name|build context|Dockerfile|extra buildx args ({SHA}: the commit, shown in the UI)
IMAGES='
rustpad|.|Dockerfile|--build-arg GITHUB_SHA={SHA}
'
TARGETS="apps/rustpad/rustpad=rustpad"
SMOKE_URLS="https://code.small-victories.co/ https://code.small-victories.co/api/stats"
MANIFESTS="k8s/apps/tier2/stacks.py"
